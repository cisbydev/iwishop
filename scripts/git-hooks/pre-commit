#!/usr/bin/env python
"""Hook pre-commit : bloque un commit contenant un secret en clair.

Contexte : incidents récurrents (6 occurrences à ce jour) de tokens/mots
de passe collés en clair dans un fichier scratch nommé "tes"/"test" à la
racine du repo. Aucun n'a jamais été commité (protection .gitignore +
vigilance manuelle), mais reposer uniquement sur un nom de fichier ou
sur la vigilance humaine n'est pas fiable dans la durée - ce hook
inspecte le CONTENU réellement mis en index (staged), quel que soit le
nom du fichier, avec des motifs à haute confiance (peu de faux positifs
volontairement, pour ne pas inciter à contourner via --no-verify).

Installation (une fois par clone du repo) :
    git config core.hooksPath scripts/git-hooks

Contournement volontaire (faux positif avéré) : git commit --no-verify
- mécanisme standard de git. Seule exception permanente : les valeurs
exactes listées dans EXCEPTIONS_AUTORISEES (fichier + valeur), à garder
aussi courte que possible.

Échec fermé : un fichier indexé n'est sauté que s'il est binaire (cité
dans la sortie) ; un fichier illisible ou une erreur inattendue bloque le
commit, jamais l'inverse.

Tests : python -m unittest discover -s scripts/git-hooks -p "test_*.py" -v
"""
import re
import subprocess
import sys

# Chaque motif : (nom_categorie, regex). Volontairement à haute
# confiance (peu de faux positifs) plutôt qu'exhaustif - un scanner trop
# bruyant pousse à contourner systématiquement avec --no-verify, ce qui
# annule tout l'intérêt du hook.
MOTIFS = [
    ("JWT (token eyJ...)", re.compile(r"eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}")),
    ("URL de connexion avec identifiants embarqués",
     re.compile(r"[a-zA-Z][a-zA-Z0-9+.-]*://[^\s'\"/:@]+:[^\s'\"/@]+@[^\s'\"/]+")),
    ("Clé privée (bloc PEM)",
     re.compile(r"-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----")),
    # Noms préfixés compris (STRIPE_API_KEY, CLOUDFLARE_R2_SECRET_KEY,
    # R2_SECRET_ACCESS_KEY, GITHUB_TOKEN...) : l'ancien `\bAPI_KEY\b` ne
    # voyait pas `API_KEY` précédé d'un "_" (caractère de mot). Clé
    # éventuellement entre guillemets (JSON, dict Python).
    ("Clé/secret assigné en dur",
     re.compile(
         r"(?i)\b(?:PAYDUNYA_[A-Z0-9_]+|"
         r"[A-Z0-9_]*(?:SECRET_KEY|API_KEY|ACCESS_KEY(?:_ID)?|PRIVATE_KEY|MASTER_KEY|_TOKEN|DATABASE_URL))\b"
         r"['\"]?\s*[:=]\s*['\"]?[A-Za-z0-9/+_=-]{16,}['\"]?"
     )),
    ("Clé d'accès AWS (AKIA...)", re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("Token de service connu (Stripe/GitHub/Slack)",
     re.compile(r"\b(sk_live_|sk_test_|ghp_|gho_|xox[baprs]-)[A-Za-z0-9_-]{10,}\b")),
    # Clé de l'API Anthropic (assistant Iwi), vue même hors d'une
    # affectation à un nom en ...API_KEY. Au moins 20 caractères après le
    # préfixe : la documentation qui cite « sk-ant- » passe.
    ("Clé Anthropic (sk-ant-...)", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}")),
]

# Faux positifs avérés, autorisés UNIQUEMENT dans ce fichier et pour cette
# valeur exacte (texte trouvé par le motif) : le reste du fichier reste
# surveillé, et la même valeur dans un autre fichier reste bloquée.
#
# .github/workflows/ci.yml : valeurs factices du job backend de la CI GitHub.
# - SECRET_KEY : clé Django de test, sans aucun usage hors du runner (son
#   nom le dit) ; la vraie SECRET_KEY de prod n'existe que sur Render.
# - DATABASE_URL : base PostgreSQL éphémère du service `postgres` du runner
#   (127.0.0.1, identifiants postgres/postgres par défaut de l'image),
#   détruite à la fin du job - aucun lien avec la base de prod.
#
# Chaque littéral est coupé en deux chaînes accolées pour que ce fichier ne
# déclenche pas lui-même les motifs ci-dessus quand il est commité.
EXCEPTIONS_AUTORISEES = {
    (".github/workflows/ci.yml", "SECRET_KEY" ": ci-test-secret-key-not-for-production-0123456789"),
    # Le motif d'URL s'arrête au premier "/" après l'hôte : le texte trouvé
    # n'inclut pas le nom de la base (/iwishop_test).
    (".github/workflows/ci.yml", "postgresql://postgres:postgres" "@127.0.0.1:5432"),
}

# Défense en profondeur, en plus de la règle .gitignore /tes /test :
# si l'un de ces deux noms était un jour ajouté de force (git add -f),
# le hook bloque quand même, indépendamment du contenu.
NOMS_FICHIERS_BLOQUES = {"tes", "test"}


# Fichier binaire = octet nul dans ses 8 000 premiers octets (même règle
# que git pour décider d'afficher un diff).
TAILLE_DETECTION_BINAIRE = 8000


class LectureImpossible(Exception):
    """Fichier indexé que git ne peut pas lire : commit bloqué."""

    def __init__(self, chemin, detail):
        super().__init__(f"{chemin} ({detail})")
        self.chemin = chemin
        self.detail = detail


def fichiers_indexes():
    # -z : chemins bruts. Sans -z, git écrit un nom avec accent entre
    # guillemets et échappé ("caf\303\251.txt"), que `git show` ne trouve
    # plus. R et T en plus de ACM : un fichier renommé (ou changé de type)
    # dans le même commit qu'une modification est analysé lui aussi.
    sortie = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "-z", "--diff-filter=ACMRT"],
        capture_output=True, check=True,
    )
    return [chemin.decode("utf-8") for chemin in sortie.stdout.split(b"\0") if chemin]


def contenu_indexe(chemin):
    """Contenu STAGED (pas le fichier sur disque) : c'est exactement ce
    qui serait commité, pas ce qui traîne éventuellement en plus dans le
    working tree.

    Lu en octets puis décodé en UTF-8 : avec text=True, Python décodait
    selon la langue du système (cp1252 sous Windows), et un octet inconnu
    de cet encodage (U+FE0F d'un emoji, par exemple) faisait sauter le
    fichier sans l'analyser. Renvoie None pour un fichier binaire."""
    resultat = subprocess.run(["git", "show", f":{chemin}"], capture_output=True)
    if resultat.returncode != 0:
        erreur = resultat.stderr.decode("utf-8", errors="replace").strip()
        raise LectureImpossible(chemin, f"git show : {erreur or f'code {resultat.returncode}'}")
    if b"\0" in resultat.stdout[:TAILLE_DETECTION_BINAIRE]:
        return None
    return resultat.stdout.decode("utf-8", errors="replace")


def masque(valeur):
    valeur = valeur.strip()
    if len(valeur) <= 12:
        return "*" * len(valeur)
    return f"{valeur[:4]}...{valeur[-4:]} ({len(valeur)} caractères)"


def analyser_contenu(chemin, contenu):
    problemes = []
    for numero_ligne, ligne in enumerate(contenu.splitlines(), start=1):
        for categorie, motif in MOTIFS:
            trouve = motif.search(ligne)
            if trouve and (chemin, trouve.group(0)) not in EXCEPTIONS_AUTORISEES:
                problemes.append((chemin, numero_ligne, categorie, masque(trouve.group(0))))
    return problemes


def analyser_index():
    problemes = []

    for chemin in fichiers_indexes():
        nom = chemin.rsplit("/", 1)[-1]
        if nom.lower() in NOMS_FICHIERS_BLOQUES:
            problemes.append((chemin, None, "Nom de fichier bloqué (tes/test)", nom))
            continue

        contenu = contenu_indexe(chemin)
        if contenu is None:
            print(f"[pre-commit] Fichier binaire non analysé : {chemin}", file=sys.stderr)
            continue

        problemes.extend(analyser_contenu(chemin, contenu))

    return problemes


def main():
    try:
        problemes = analyser_index()
    except LectureImpossible as erreur:
        print(
            f"\n[pre-commit] Impossible de lire {erreur.chemin} dans l'index "
            f"({erreur.detail}) : commit bloqué par prudence.",
            file=sys.stderr,
        )
        return 1
    except Exception as erreur:
        # Échec fermé : sans analyse complète, pas de commit.
        print(
            f"\n[pre-commit] Erreur inattendue ({type(erreur).__name__} : {erreur}) : "
            "commit bloqué par prudence.",
            file=sys.stderr,
        )
        return 1

    if problemes:
        print("\n[pre-commit] Secret potentiel détecté - commit bloqué :\n", file=sys.stderr)
        for chemin, ligne_no, categorie, apercu in problemes:
            localisation = f"{chemin}:{ligne_no}" if ligne_no else chemin
            print(f"  - {localisation} - {categorie} - {apercu}", file=sys.stderr)
        print(
            "\nSi c'est un faux positif confirmé : `git commit --no-verify`.\n"
            "Sinon : retire le secret du fichier avant de recommiter.",
            file=sys.stderr,
        )
        return 1

    return 0


if __name__ == "__main__":
    # Un chemin que la console ne sait pas afficher ne doit pas faire
    # planter le message de blocage.
    sys.stderr.reconfigure(errors="backslashreplace")
    sys.exit(main())
